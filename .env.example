# Variables del entorno de liberación de Consultorio Digital.
# Copia este archivo a .env y complétalo. ¡Nunca subas .env al repositorio!

# ── Aplicación (las usa scripts/env/generate-env.mjs) ───────────────────────
SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
SUPABASE_ANON_KEY=<clave-publica-anon>
APP_ENV=staging            # staging | production

# ── Despliegue (Vercel) ─────────────────────────────────────────────────────
VERCEL_TOKEN=<token-de-vercel>
VERCEL_ORG_ID=<orgId de .vercel/project.json>
VERCEL_PROJECT_ID=<projectId de .vercel/project.json>
VERCEL_AUTOMATION_BYPASS_SECRET=<secreto de Deployment Protection → Protection Bypass for Automation>

# ── Pruebas E2E en el entorno de liberación ─────────────────────────────────
BASE_URL=http://localhost:4200
E2E_STAFF_EMAIL=<correo de la cuenta de staff de pruebas>
E2E_STAFF_PASSWORD=<contraseña de la cuenta de staff de pruebas>
